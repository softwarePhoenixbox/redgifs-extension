{
  "name": "redgifs-extension",
  "description": "manifest.json description",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "build:basic": "wxt build --mode basic",
    "build:premium": "wxt build --mode premium",
    "build:activated": "wxt build --mode activated",
    "build:all": "pnpm build:basic && pnpm build:premium && pnpm build:activated",
    "zip:basic": "wxt zip --mode basic",
    "zip:premium": "wxt zip --mode premium"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^3.2.7",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.11.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.12.0",
      "source-map-js": "1.2.2",
      "image-size": "2.0.4"
    }
  }
}
